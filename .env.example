BOT_TOKEN=*******
ADMIN_IDS=********

# Database (SQLite for start)
DATABASE_URL=sqlite+aiosqlite:///./wb_monitor.db

# Later for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/wb_monitor

# Email (optional for stage 5)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# Parser settings
PARSER_DELAY_MIN=1.0
PARSER_DELAY_MAX=3.0

# Интервал опроса WB в секундах
DEFAULT_UPDATE_INTERVAL_SECONDS=60

# Сколько товаров можно опрашивать одновременно
MAX_CONCURRENT_PARSES=5
MAX_PRODUCTS_PER_USER=50

# ===== Mini App (Telegram Web App) =====

# Публичный HTTPS-адрес Mini App
# После запуска ngrok сюда нужно вставить полученный HTTPS-адрес.
# Например:
# WEBAPP_URL=https://abc123.ngrok-free.app

WEBAPP_URL=*******
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
WEBAPP_INIT_DATA_MAX_AGE=86400
WEBAPP_DEV_MODE=false